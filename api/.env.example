# ─── Server ─────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development          # development | staging | production
PORT=8089
CLIENT_SLUG=ferreteria-del-norte   # kebab-case, used in dataset names and logs
CLIENT_NAME=Ferretería del Norte   # human-readable
FRONTEND_URL=http://localhost:3001

# ─── Database ───────────────────────────────────────────────
# DATABASE_URL takes priority over DB_* fields. Use it in staging/prod.
# Local Postgres for dev:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=erp_ferreteria_del_norte
DB_SSL=false

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Seed ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@puroerp.com
ADMIN_PASSWORD=admindemo1
SEED_DEMO_DATA=false
SEED_FERRETERIA_DEMO=true       # demo retail seed (Ferretería del Norte)

# ─── Fiscal AR ──────────────────────────────────────────────
AFIP_SANDBOX_STUB=true          # genera CAE simulado, no llama a WSFE real

# ─── Observability (Axiom) ──────────────────────────────────
# Empty in local. In prod, set via Coolify env vars (dataset is shared across demos;
# discriminate queries with `client_slug == "<slug>"`).
# AXIOM_TOKEN=xaat-xxxx
# AXIOM_DATASET=erp-demos-shared

# ─── Runtime meta (populated by platform, do not set manually) ──
# GIT_SHA=
